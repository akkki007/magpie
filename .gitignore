# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/

/lib/generated/prisma

# ...but the template for it is committed.
!.env.example

# generated reconciliation fixtures — deterministic, regenerate with `bun run recon:seed`
/data

# demo recordings — oculon-product.mp4 is 22MB and was swept into a commit once
# already, then removed with `git rm --cached`. Ignored as a pattern so the next
# recording does not repeat it.
*.mp4

# Planning docs and design spec. Untracked deliberately — they are working notes for
# building Magpie, not part of what it ships. Source comments still cite them by path
# (`docs/modelling-plan.md` §1.1 and friends); those are references for whoever has the
# folder, not files a fresh clone will find.
/docs/

# Personal notes, not project material.
/how-to-pitch.md

# Vendored Supabase agent skills, pulled from supabase/agent-skills. Local tooling, and
# somebody else's source to be re-fetched rather than committed here. Note the paths name
# these two specifically: design-from-references and teach are ours and stay tracked.
/skills-lock.json
/.agents/skills/supabase/
/.agents/skills/supabase-postgres-best-practices/
/.claude/skills/supabase
/.claude/skills/supabase-postgres-best-practices
