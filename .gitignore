# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/

/lib/generated/prisma

# ...but the template for it is committed.
!.env.example

# generated reconciliation fixtures — deterministic, regenerate with `bun run recon:seed`
/data

# demo recordings — oculon-product.mp4 is 22MB and was swept into a commit once
# already, then removed with `git rm --cached`. Ignored as a pattern so the next
# recording does not repeat it.
*.mp4
