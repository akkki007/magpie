# Copy to .env and fill in. `.env` is gitignored; this file is not.

# ── The database ───────────────────────────────────────────────────────────────
# Two URLs, because the app and the Prisma CLI need different things from the
# connection. Locally they are the same string and DIRECT_URL can be left unset;
# against a managed Postgres they must differ, and getting it wrong fails in a way
# that does not look like a configuration problem.
#
#   DATABASE_URL  the app, via the driver adapter in `lib/db.ts`. Serverless opens
#                 many short-lived connections, so this wants a *transaction*-mode
#                 pooler — on Supabase, port 6543.
#   DIRECT_URL    `prisma migrate` / `db pull`, via `prisma7.config.ts`. Migrations
#                 take advisory locks and run DDL across statements, and neither
#                 exists in transaction mode, so this needs a *session* — port 5432.
#
# Point both at the pooler and `migrate deploy` reports `P1001: Can't reach database
# server` against a host that is demonstrably reachable: the pooler accepts the TCP
# connection, then refuses the session the migration asks for.

# Local Postgres. The `magpie` role owns only magpie_dev — create it with:
#   createdb magpie_dev
#   psql -d postgres -c "CREATE ROLE magpie LOGIN PASSWORD '<pw>' CREATEDB;"
#   psql -d magpie_dev -c "ALTER SCHEMA public OWNER TO magpie;"
# (CREATEDB is only needed so Prisma can build its shadow database.)
DATABASE_URL="postgresql://magpie:<pw>@localhost:5432/magpie_dev"

# Optional. Unset, `prisma7.config.ts` falls back to DATABASE_URL — right for a local
# Postgres, and for any deploy where one session-mode URL serves both. Set it when the
# app is pointed at a transaction-mode pooler:
#   DIRECT_URL="postgresql://<user>:<pw>@<host>:5432/postgres?sslmode=require"
DIRECT_URL=

# Signs session cookies and hashes tokens. Rotating it invalidates every session.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# The reconciliation adjudication tier (`docs/recon-plan.md` R4). Optional:
# `bun run recon:agent --dry-run` exercises the whole validation gate without a provider,
# but a live run and the §A8 ablation need a key.
OPENAI_API_KEY=

# The model, and the rates the cost line is computed from. Leave the rates unset and the
# scoreboard prints "rates not configured" rather than inventing a rupee figure — a made-up
# cost on a slide is worse than an empty cell.
OPENAI_MODEL=gpt-5.6
OPENAI_INPUT_PER_MTOK=
OPENAI_OUTPUT_PER_MTOK=
USD_TO_INR=

# Transactional mail (magic links, email verification), over Resend's HTTP API.
# Leave the key unset and every email is printed to the server log instead of sent, so a
# fresh clone can walk the whole sign-in flow without an account anywhere.
#   `bun run mail:check` proves the key works and the sending domain is verified.
RESEND_API_KEY=

# Optional. The address must sit on a domain verified in Resend — the DKIM signature is
# what inboxes check, not whether a mailbox is listening at `hello@`.
MAIL_FROM="Magpie <hello@magpie.akkki.tech>"
